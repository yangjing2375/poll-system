  "item": [
    {
      "name": "01 认证",
      "item": [
        {
          "name": "注册新用户",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/register.php",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "register.php"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{regUser}}\",\"email\":\"{{regUser}}@example.com\",\"password\":\"123456\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set(\"regUser\", \"user\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test(\"注册成功\", () => { pm.expect(j.status).to.eql(\"success\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "注册-用户名重复",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
